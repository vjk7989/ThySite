---
// Destructure the properties from Astro.props
const { id, url, name } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  id: string;
  url: string;
  name: string;
}
---

{/*
Re-usable link component for navigation bar. Highlights the active link
by comparing the current URL with the href of each link.
The caller supplies the stable navigation ID because deployed URLs can include
the GitHub Pages repository base.
*/}
<a
  id={id}
  href={url}
  data-astro-prefetch
  class="rounded-lg text-base font-medium text-neutral-600 ring-zinc-500 outline-hidden hover:text-neutral-500 focus-visible:ring-3 md:py-3 md:text-sm 2xl:text-base dark:text-neutral-400 dark:ring-zinc-200 dark:hover:text-neutral-500 dark:focus:outline-hidden"
>
  {name}
</a>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    let url = window.location.pathname;
    let navId;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');

    if (base && (url === base || url.startsWith(`${base}/`))) {
      url = url.slice(base.length) || '/';
    }

    if (url === '/') {
      navId = 'home';
    } else {
      navId = url.replace('/', '');
    }

    let nav = document.getElementById(navId);

    if (nav) {
      nav.classList.remove(
        'text-neutral-600',
        'dark:text-neutral-400',
        'hover:text-neutral-500',
        'dark:hover:text-neutral-500'
      );
      nav.classList.add('text-brand-600', 'dark:text-orange-300');
      nav.setAttribute('aria-current', 'page');
    }
  });
</script>

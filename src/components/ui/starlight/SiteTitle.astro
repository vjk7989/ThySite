---
import BrandLogo from '@components/BrandLogo.astro';
import type { Props } from '@astrojs/starlight/props';
import { sitePath } from '@utils/paths';

const main = sitePath('/');
const locale = Astro.props.locale ? Astro.props.locale + '/' : '';
const docs = sitePath('/' + locale + 'welcome-to-docs/');
---

<span class="site-title flex">
  <a class="main-logo" href={main} aria-label="Buckleson">
    <BrandLogo class="text-lg" />
  </a>
  <a class="docs-logo" href={docs} aria-label="Buckleson Platform">
    Platform
  </a>
</span>

<style>
  .site-title {
    gap: 1rem;
    margin-right: 1rem;
  }
  .site-title a {
    display: flex;
  }

  .flex {
    display: flex;
    align-items: center;
  }
  .site-title a:focus-visible {
    outline: 0;
  }
  .site-title a:focus-visible > :global(*) {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .site-title a:hover {
    transform: translateY(calc(0.1rem * -1));
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }

  .docs-logo {
    color: var(--sl-color-gray-2);
    font-size: 0.875rem;
    font-weight: 600;
  }
</style>

---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import { sitePath } from '@utils/paths';

interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<article class="mx-auto max-w-4xl py-12 sm:py-20">
  <header class="mx-auto max-w-3xl text-center">
    <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
      Risk library
    </p>
    <h1 class="mt-5 text-4xl font-bold tracking-[-0.035em] text-foreground sm:text-5xl lg:text-6xl">
      {post.data.title}
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
      {post.data.description}
    </p>
  </header>
  <Image
    src={post.data.cardImage}
    alt={post.data.cardImageAlt}
    widths={[720, 1080, 1440]}
    sizes="(min-width: 1024px) 896px, 100vw"
    class="mt-12 aspect-[8/5] w-full rounded-3xl bg-primary/5 object-cover"
    loading="eager"
  />
  <div class="mx-auto mt-12 max-w-3xl">
    <div class="prose prose-lg prose-neutral dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-a:text-primary prose-strong:text-foreground">
      <Content />
    </div>
    <aside class="mt-12 rounded-2xl border border-border bg-muted/35 p-6">
      <h2 class="text-lg font-bold text-foreground">
        Use this as a review prompt
      </h2>
      <p class="mt-2 text-sm leading-7 text-muted-foreground">
        Apply the control to a defined execution point, test its failure states,
        name an evidence owner, and record what remains outside the boundary.
      </p>
    </aside>
    <a
      href={sitePath('/blog')}
      class="mt-10 inline-flex text-sm font-bold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
    >
      Back to Insights
    </a>
  </div>
</article>

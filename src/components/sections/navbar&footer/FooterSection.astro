---
import FooterSocialLink from '@components/ui/links/FooterSocialLink.astro';
import Icon from '@components/ui/icons/Icon.astro';
import BrandLogo from '@components/BrandLogo.astro';
import { BOOKING_URL, SITE } from '@data/constants';
import { navLinks, socialLinks } from '@data/navigation';
import { localePath } from '@utils/locale';

const { locale, copy: t } = Astro.locals;
const socialIconClass =
  'h-4 w-4 shrink-0 text-muted-foreground transition hover:text-foreground';
---

<footer class="mt-20 w-full border-t border-border bg-card text-card-foreground">
  <div class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 2xl:max-w-(--breakpoint-2xl)">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between">
      <div class="max-w-md">
        <BrandLogo class="text-lg" />
        <p class="mt-4 text-sm leading-6 text-muted-foreground">
          {t.site.descriptionShort}
        </p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Footer">
        {navLinks
          .filter(link => link.id !== 'home')
          .map(link => (
            <a
              href={localePath(locale, link.path)}
              class="rounded-md text-sm font-medium text-muted-foreground outline-none transition hover:text-foreground focus-visible:ring-3 focus-visible:ring-ring"
            >
              {t.nav.labels[link.id]}
            </a>
          ))}
        <a
          href={BOOKING_URL}
          class="rounded-md text-sm font-semibold text-primary outline-none transition hover:opacity-80 focus-visible:ring-3 focus-visible:ring-ring dark:text-foreground"
        >
          {t.nav.bookAssessment}
        </a>
      </nav>
    </div>

    <div class="mt-10 flex items-center justify-between border-t border-border pt-6">
      <p class="text-sm text-muted-foreground">
        © <span id="current-year"></span> {SITE.title}. {t.nav.footer.rights}
      </p>
      <FooterSocialLink url={socialLinks.github} label="GitHub">
        <Icon name="githubMark" class={socialIconClass} title="GitHub" />
      </FooterSocialLink>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById('current-year');
      element!.innerText = year.toString();
    </script>
  </div>
</footer>

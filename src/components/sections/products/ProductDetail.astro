---
import type { CollectionEntry } from 'astro:content';
import ModuleDiagram from '@components/sections/products/ModuleDiagram.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { BOOKING_URL } from '@data/constants';
import { sitePath } from '@utils/paths';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const platformPath = sitePath('/products');
---

<article>
  <header class="grid items-end gap-10 border-b border-border py-16 sm:py-24 lg:grid-cols-[1.1fr_.9fr] lg:py-28">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        {product.data.eyebrow}
      </p>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.04em] text-foreground sm:text-6xl lg:text-7xl">
        {product.data.title}
      </h1>
      <p class="mt-6 max-w-3xl text-xl leading-8 text-muted-foreground">
        {product.data.summary}
      </p>
    </div>
    <div class="flex flex-col items-start gap-4 lg:items-end">
      <span class="rounded-full bg-primary/10 px-4 py-2 text-sm font-bold tracking-wide text-primary uppercase">
        {product.data.action}
      </span>
      <a
        href={platformPath}
        class="text-sm font-bold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
      >
        Back to Platform
      </a>
    </div>
  </header>

  <section
    class="py-16 sm:py-24"
    aria-label={`${product.data.title} architecture`}
  >
    <ModuleDiagram kind={product.data.diagram} />
  </section>

  <section
    class="grid gap-8 pb-16 sm:pb-24 lg:grid-cols-3"
    aria-labelledby="capabilities-title"
  >
    <div class="lg:col-span-3">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Capabilities
      </p>
      <h2
        id="capabilities-title"
        class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
      >
        What this module contributes
      </h2>
    </div>
    {product.data.capabilities.map((capability, index) => (
      <article class="rounded-2xl border border-border bg-card p-7">
        <span class="font-mono text-sm text-primary">0{index + 1}</span>
        <h3 class="mt-8 text-xl font-bold text-card-foreground">
          {capability.title}
        </h3>
        <p class="mt-3 text-sm leading-7 text-muted-foreground">
          {capability.body}
        </p>
      </article>
    ))}
  </section>

  <section class="grid gap-8 border-y border-border py-16 sm:py-24 lg:grid-cols-2">
    <div>
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Execution flow
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">
        A bounded path, not a black box
      </h2>
      <ol class="mt-8 space-y-5">
        {product.data.flow.map((step, index) => (
          <li class="flex gap-4 rounded-2xl bg-muted/45 p-5">
            <span class="font-mono text-sm text-primary">0{index + 1}</span>
            <span class="text-sm leading-6 text-foreground">{step}</span>
          </li>
        ))}
      </ol>
    </div>
    <div>
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Control boundaries
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">
        What it does not prove
      </h2>
      <ul class="mt-8 divide-y divide-border border-y border-border">
        {product.data.boundaries.map(boundary => (
          <li class="flex gap-4 py-5 text-sm leading-6 text-muted-foreground">
            <span aria-hidden="true" class="text-primary">
              —
            </span>
            {boundary}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="my-16 rounded-3xl bg-primary px-6 py-12 text-primary-foreground sm:my-24 sm:px-10 lg:flex lg:items-center lg:justify-between lg:gap-12">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-bold tracking-tight">
        Test the boundary on one real workflow.
      </h2>
      <p class="mt-4 leading-7 opacity-80">
        An assessment identifies the enforcement point, evidence, and
        surrounding controls needed before integration.
      </p>
    </div>
    <div class="mt-8 shrink-0 lg:mt-0">
      <PrimaryCTA
        title="Book an Assessment"
        url={BOOKING_URL}
        variant="yellow"
      />
    </div>
  </section>
</article>

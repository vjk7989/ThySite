          <path d="M 0 0 L 10 5 L 0 10 z" class="fill-primary"></path>
        </marker>
        <linearGradient id="trust-boundary" x1="0" x2="1">
          <stop
            offset="0"
            stop-color="var(--primary)"
            stop-opacity=".15"
          ></stop>
          <stop
            offset="1"
            stop-color="var(--primary)"
            stop-opacity=".03"
          ></stop>
        </linearGradient>
      </defs>

      <rect
        x="188"
        y="55"
        width="710"
        height="300"
        rx="30"
        fill="url(#trust-boundary)"
        class="stroke-primary/35"
        stroke-dasharray="8 8"
      ></rect>
      <text

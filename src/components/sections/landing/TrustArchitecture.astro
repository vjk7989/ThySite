</figure>

<script>
  import { animate, createScope, stagger } from 'animejs';

  const scopes = new WeakMap<Element, ReturnType<typeof createScope>>();

  const initialiseArchitecture = () => {
    document
      .querySelectorAll<HTMLElement>('[data-trust-architecture]')
      .forEach(root => {
        scopes.get(root)?.revert();
        const scope = createScope({
          root,
          mediaQueries: { reducedMotion: '(prefers-reduced-motion: reduce)' },
        }).add(context => {
          if (!context || context.matches.reducedMotion) return;
          animate('[data-architecture-node]', {
            opacity: [0.72, 1],
            translateY: [6, 0],
            delay: stagger(90),
            duration: 560,
            ease: 'out(3)',
          });
          animate('[data-architecture-path] path', {
            opacity: [0.45, 1],
            delay: stagger(110, { start: 220 }),
            duration: 640,
            ease: 'out(3)',
          });
        });
        scopes.set(root, scope);
      });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseArchitecture, {
      once: true,
    });
  } else {
    initialiseArchitecture();
  }

  document.addEventListener('astro:page-load', initialiseArchitecture);
  document.addEventListener('astro:before-swap', () => {
    document
      .querySelectorAll('[data-trust-architecture]')
      .forEach(root => scopes.get(root)?.revert());
  });
</script>

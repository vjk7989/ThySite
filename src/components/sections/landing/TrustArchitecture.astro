        <text
          x="88"
          y="216"
          text-anchor="middle"
          class="fill-muted-foreground text-[13px]"
        >
          Intent + scope
        </text>
      </g>
      <g data-architecture-node>
        <rect
          x="245"
          y="145"
          width="185"
          height="110"
          rx="18"
          class="fill-card stroke-primary"
          stroke-width="3"
        ></rect>
        <text

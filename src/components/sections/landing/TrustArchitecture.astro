        data-architecture-path
      >
        <path d="M 168 200 H 245"></path>
        <path d="M 430 200 H 505"></path>
        <path d="M 690 200 H 765"></path>
        <path d="M 950 200 H 1022"></path>
        <path d="M 858 249 V 318 H 725"></path>
      </g>

      <g data-architecture-node>
        <rect
          x="8"
          y="151"
          width="160"
          height="98"
          rx="18"
          class="fill-muted stroke-border"
          stroke-width="2"
        ></rect>
        <text
          x="88"

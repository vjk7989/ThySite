<figure
  class="trust-architecture overflow-hidden rounded-3xl border border-border bg-card p-4 shadow-sm sm:p-6 lg:p-8"
  aria-labelledby="trust-architecture-title"
  aria-describedby="trust-architecture-description"
  data-trust-architecture

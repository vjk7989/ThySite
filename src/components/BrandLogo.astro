---
const { class: className = '' } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-2 font-semibold tracking-[-0.025em] text-brand-ink dark:text-neutral-100',
    className,
  ]}
  aria-hidden="true"
>
  <span class="size-2.5 rounded-full bg-brand-500 dark:bg-yellow-400"></span>
  <span>Buckleson</span>
</span>

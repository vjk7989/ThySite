---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import { entriesFor, localeOf, pathFor } from '@utils/content';
import { capitalize, formatDate } from '@utils/utils';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const locale = localeOf(post);
const { Content } = await render(post);
const relatedPosts = (await entriesFor('blog', locale)).filter(
  entry => entry.id !== post.id
);
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  section="Insights"
  kind={{
    type: 'BlogPosting',
    image: post.data.cardImage.src,
    datePublished: post.data.pubDate,
    author: post.data.author,
  }}
>
  <article class="mx-auto max-w-4xl py-12 sm:py-20">
    <header class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Buckleson field note
      </p>
      <h1 class="mt-5 text-4xl font-bold tracking-[-0.035em] text-foreground sm:text-5xl lg:text-6xl">
        {post.data.title}
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
        {post.data.description}
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-3 text-sm text-muted-foreground">
        <span class="font-semibold text-foreground">{post.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={post.data.pubDate.toISOString()}>
          {formatDate(post.data.pubDate, locale)}
        </time>
        <span aria-hidden="true">·</span>
        <span>{post.data.readTime} min read</span>
      </div>
    </header>

    <Image
      src={post.data.cardImage}
      alt={post.data.cardImageAlt}
      widths={[720, 1080, 1440]}
      sizes="(min-width: 1024px) 896px, 100vw"
      class="mt-12 aspect-[8/5] w-full rounded-3xl bg-primary/5 object-cover"
      loading="eager"
    />

    <div class="mx-auto mt-12 max-w-3xl">
      <div class="mb-8 flex flex-wrap gap-2">
        {post.data.tags?.map(tag => (
          <span class="rounded-full bg-primary/10 px-3 py-1.5 text-xs font-semibold text-primary">
            {capitalize(tag)}
          </span>
        ))}
      </div>
      <div class="prose prose-lg prose-neutral dark:prose-invert max-w-none prose-headings:scroll-mt-24 prose-headings:tracking-tight prose-a:text-primary prose-strong:text-foreground">
        <Content />
      </div>
      <aside class="mt-12 rounded-2xl border border-border bg-muted/35 p-6 text-sm leading-7 text-muted-foreground">
        <strong class="text-foreground">Scope note:</strong> This article
        provides general engineering guidance. Control effectiveness depends on
        the complete deployment, configuration, integrations, data, and
        operating process.
      </aside>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section
      class="border-t border-border py-16 sm:py-20"
      aria-labelledby="related-articles-title"
    >
      <h2 id="related-articles-title" class="text-3xl font-bold tracking-tight">
        Related field notes
      </h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">
        {relatedPosts.map(entry => (
          <a
            href={pathFor(entry)}
            class="rounded-2xl border border-border bg-card p-6 transition hover:border-primary/40 focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
          >
            <p class="text-xs font-semibold tracking-wide text-primary uppercase">
              {entry.data.readTime} min read
            </p>
            <h3 class="mt-3 text-xl font-bold text-card-foreground">
              {entry.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              {entry.data.description}
            </p>
          </a>
        ))}
      </div>
    </section>
  )}
</MainLayout>

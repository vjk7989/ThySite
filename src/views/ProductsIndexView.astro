---
import MainLayout from '@/layouts/MainLayout.astro';
import TrustArchitecture from '@components/sections/landing/TrustArchitecture.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { BOOKING_URL } from '@data/constants';
import { entriesFor, pathFor } from '@utils/content';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const products = await entriesFor('products', locale);
const primaryProducts = products.filter(product => !product.data.secondary);
const wallet = products.find(product => product.data.secondary);
---

<MainLayout
  title="Platform"
  description="Control AI routes, protect task context, and verify execution with Buckleson’s model-agnostic trust platform."
  ogTitle="Buckleson AI Trust Platform"
>
  <section class="grid items-end gap-10 py-16 sm:py-24 lg:grid-cols-[1.08fr_.92fr] lg:py-28">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Buckleson Platform
      </p>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.04em] sm:text-6xl lg:text-7xl">
        A trust layer across the AI execution path.
      </h1>
    </div>
    <div>
      <p class="text-lg leading-8 text-muted-foreground">
        Control which capabilities an AI can reach, reduce unnecessary raw-data
        exposure before inference, and retain verifiable records of what
        occurred.
      </p>
      <div class="mt-7">
        <PrimaryCTA title="Book an Assessment" url={BOOKING_URL} />
      </div>
    </div>
  </section>

  <section class="pb-20 sm:pb-28" aria-labelledby="platform-architecture-title">
    <h2 id="platform-architecture-title" class="sr-only">
      Buckleson platform architecture
    </h2>
    <TrustArchitecture />
  </section>

  <section
    class="border-y border-border py-20 sm:py-28"
    aria-labelledby="primary-modules-title"
  >
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Primary modules
      </p>
      <h2
        id="primary-modules-title"
        class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl"
      >
        Control. Protect. Verify.
      </h2>
      <p class="mt-5 text-lg leading-8 text-muted-foreground">
        Each module owns one explicit responsibility. Together they create a
        reviewable path from request to execution record.
      </p>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {primaryProducts.map(product => (
        <a
          href={pathFor(product)}
          class="group flex min-h-[360px] flex-col rounded-3xl border border-border bg-card p-7 transition hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none sm:p-8"
        >
          <div class="flex items-center justify-between">
            <span class="rounded-full bg-primary/10 px-3 py-1 text-xs font-bold tracking-wide text-primary uppercase">
              {product.data.action}
            </span>
            <span
              aria-hidden="true"
              class="text-xl text-primary transition group-hover:translate-x-1"
            >
              →
            </span>
          </div>
          <div
            class="my-10 grid grid-cols-[1fr_auto_1fr] items-center gap-3"
            aria-hidden="true"
          >
            <span class="h-2.5 rounded-full bg-muted-foreground/30"></span>
            <span class="h-10 w-10 rounded-xl border border-primary/30 bg-primary/10"></span>
            <span class="h-2.5 rounded-full bg-primary/45"></span>
          </div>
          <h3 class="text-2xl font-bold text-card-foreground">
            {product.data.title}
          </h3>
          <p class="mt-4 grow text-sm leading-7 text-muted-foreground">
            {product.data.summary}
          </p>
          <span class="mt-8 text-sm font-bold text-primary">
            Explore the module
          </span>
        </a>
      ))}
    </div>
  </section>

  {wallet && (
    <section
      class="grid gap-10 py-20 sm:py-28 lg:grid-cols-[.75fr_1.25fr] lg:items-center"
      aria-labelledby="wallet-title"
    >
      <div>
        <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
          Supporting proof
        </p>
        <h2
          id="wallet-title"
          class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl"
        >
          Hyper Wallet
        </h2>
        <p class="mt-5 text-lg leading-8 text-muted-foreground">
          {wallet.data.summary}
        </p>
        <a
          href={pathFor(wallet)}
          class="mt-7 inline-flex text-sm font-bold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary"
        >
          See Hyper Wallet
        </a>
      </div>
      <div class="rounded-3xl border border-border bg-muted/35 p-7 sm:p-10">
        <div
          class="grid grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-3"
          aria-hidden="true"
        >
          <span class="rounded-2xl border border-border bg-card p-5 text-center text-sm font-bold">
            Identity
          </span>
          <span class="text-primary">→</span>
          <span class="rounded-2xl border border-primary/30 bg-primary/10 p-5 text-center text-sm font-bold">
            Signed intent
          </span>
          <span class="text-primary">→</span>
          <span class="rounded-2xl border border-border bg-card p-5 text-center text-sm font-bold">
            Receipt
          </span>
        </div>
        <p class="mt-7 text-sm leading-6 text-muted-foreground">
          A supporting identity and signing interface—not a replacement for
          enterprise identity, key management, or recovery controls.
        </p>
      </div>
    </section>
  )}

  <section class="mb-16 rounded-3xl border border-border bg-card p-7 sm:p-10 lg:flex lg:items-center lg:justify-between lg:gap-12">
    <div class="max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Model-agnostic by design
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight">
        Keep the trust boundary stable as models change.
      </h2>
      <p class="mt-4 leading-7 text-muted-foreground">
        The platform sits around configured execution flows. Integration
        feasibility depends on the enforcement points exposed by your
        applications, agents, model providers, and data systems.
      </p>
    </div>
    <div class="mt-8 shrink-0 lg:mt-0">
      <PrimaryCTA title="Assess your architecture" url={BOOKING_URL} />
    </div>
  </section>
</MainLayout>

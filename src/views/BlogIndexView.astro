---
import { Image } from 'astro:assets';
import MainLayout from '@/layouts/MainLayout.astro';
import { entriesFor, pathFor } from '@utils/content';
import { formatDate } from '@utils/utils';
import type { MarketingLocale } from '@utils/locale';

interface Props {
  locale: MarketingLocale;
}

const { locale } = Astro.props;
const blogPosts = await entriesFor('blog', locale);
const insightPosts = await entriesFor('insights', locale);
const [featuredPost, ...otherPosts] = blogPosts;
---

<MainLayout
  title="Insights"
  description="Practical guidance on agentic AI security, secure inference, execution boundaries, and verifiable evidence."
  ogTitle="Buckleson AI Safety Insights"
>
  <section class="grid items-end gap-10 py-16 sm:py-24 lg:grid-cols-[1.05fr_.95fr] lg:py-28">
    <div class="max-w-4xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Insights
      </p>
      <h1 class="mt-4 text-5xl font-bold tracking-[-0.04em] sm:text-6xl lg:text-7xl">
        Make AI risk concrete enough to control.
      </h1>
    </div>
    <p class="text-lg leading-8 text-muted-foreground">
      Engineering notes on execution boundaries, data exposure, prompt
      injection, verification, and the limits every control should state.
    </p>
  </section>

  {featuredPost && (
    <section
      class="border-y border-border py-16 sm:py-20"
      aria-labelledby="featured-insight-title"
    >
      <a
        href={pathFor(featuredPost)}
        class="group grid gap-8 rounded-3xl bg-muted/35 p-5 focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none sm:p-8 lg:grid-cols-[1.05fr_.95fr] lg:items-center"
      >
        <div class="overflow-hidden rounded-2xl bg-primary/5">
          <Image
            src={featuredPost.data.cardImage}
            alt={featuredPost.data.cardImageAlt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 52vw, 100vw"
            class="aspect-[8/5] w-full object-cover transition duration-500 group-hover:scale-[1.02]"
            loading="eager"
          />
        </div>
        <div class="p-2 sm:p-4">
          <div class="flex flex-wrap items-center gap-3 text-xs font-semibold tracking-wide text-muted-foreground uppercase">
            <span class="text-primary">Featured</span>
            <span aria-hidden="true">·</span>
            <time datetime={featuredPost.data.pubDate.toISOString()}>
              {formatDate(featuredPost.data.pubDate, locale)}
            </time>
            <span aria-hidden="true">·</span>
            <span>{featuredPost.data.readTime} min read</span>
          </div>
          <h2
            id="featured-insight-title"
            class="mt-5 text-3xl font-bold tracking-tight text-card-foreground sm:text-4xl"
          >
            {featuredPost.data.title}
          </h2>
          <p class="mt-4 text-base leading-7 text-muted-foreground">
            {featuredPost.data.description}
          </p>
          <span class="mt-7 inline-flex font-bold text-primary">
            Read the article{' '}
            <span
              aria-hidden="true"
              class="ml-2 transition group-hover:translate-x-1"
            >
              →
            </span>
          </span>
        </div>
      </a>
    </section>
  )}

  <section class="py-20 sm:py-28" aria-labelledby="field-notes-title">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Field notes
      </p>
      <h2
        id="field-notes-title"
        class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl"
      >
        Designing safer execution paths
      </h2>
    </div>
    <div class="grid gap-6 lg:grid-cols-2">
      {otherPosts.map(post => (
        <a
          href={pathFor(post)}
          class="group overflow-hidden rounded-3xl border border-border bg-card focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
        >
          <Image
            src={post.data.cardImage}
            alt={post.data.cardImageAlt}
            widths={[480, 800]}
            sizes="(min-width: 1024px) 46vw, 100vw"
            class="aspect-[8/4.5] w-full bg-primary/5 object-cover transition duration-500 group-hover:scale-[1.02]"
          />
          <div class="p-7 sm:p-8">
            <div class="flex gap-3 text-xs font-semibold text-muted-foreground uppercase">
              <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate, locale)}
              </time>
              <span aria-hidden="true">·</span>
              <span>{post.data.readTime} min read</span>
            </div>
            <h3 class="mt-4 text-2xl font-bold text-card-foreground">
              {post.data.title}
            </h3>
            <p class="mt-3 text-sm leading-7 text-muted-foreground">
              {post.data.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section
    class="border-t border-border py-20 sm:py-28"
    aria-labelledby="risk-library-title"
  >
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.18em] text-primary uppercase">
        Risk library
      </p>
      <h2
        id="risk-library-title"
        class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl"
      >
        Threats, controls, and evidence
      </h2>
      <p class="mt-5 text-lg leading-8 text-muted-foreground">
        Focused explainers that connect a risk to a concrete execution point and
        state what the proposed control cannot prove.
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {insightPosts.map(insight => (
        <a
          href={pathFor(insight)}
          class="group rounded-3xl border border-border bg-card p-4 focus-visible:ring-3 focus-visible:ring-ring focus-visible:outline-none"
        >
          <Image
            src={insight.data.cardImage}
            alt={insight.data.cardImageAlt}
            widths={[400, 640]}
            sizes="(min-width: 1024px) 30vw, (min-width: 768px) 46vw, 100vw"
            class="aspect-[8/5] w-full rounded-2xl bg-primary/5 object-cover transition duration-500 group-hover:scale-[1.01]"
          />
          <div class="p-4">
            <h3 class="text-xl font-bold text-card-foreground">
              {insight.data.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-muted-foreground">
              {insight.data.description}
            </p>
            <span class="mt-5 inline-flex text-sm font-bold text-primary">
              Read the explainer{' '}
              <span aria-hidden="true" class="ml-2">
                →
              </span>
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</MainLayout>

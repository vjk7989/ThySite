---
import MainLayout from '@/layouts/MainLayout.astro';
import InsightDetail from '@components/sections/insights/InsightDetail.astro';
import type { CollectionEntry } from 'astro:content';

/** One insight page. The locale is the entry's own. */
interface Props {
  post: CollectionEntry<'insights'>;
}

const { post } = Astro.props;
---

<MainLayout
  title={post.data.title}
  description={post.data.description}
  section="Insights"
  kind={{ type: 'Article', image: post.data.cardImage.src }}
>
  <InsightDetail post={post} />
</MainLayout>
